# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Comma-separated emails that receive owner access automatically
OWNER_EMAILS=isobel@example.com,zsuzsa@example.com

# A separate random secret used when hashing the shared invite code
INVITE_CODE_PEPPER=generate-another-long-random-secret

# Canonical deployed URL used in password-reset links
APP_URL=https://your-dashboard.example.com

# Resend credentials for password-reset email delivery
RESEND_API_KEY=re_your_sending_only_key
PASSWORD_RESET_FROM_EMAIL=Folly <hello@your-verified-domain.example>
