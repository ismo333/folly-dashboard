# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Comma-separated emails that receive owner access automatically
OWNER_EMAILS=isobel@example.com,zsuzsa@example.com

# Random secret for hashing the invite code (invite codes are switched off for now)
INVITE_CODE_PEPPER=generate-another-long-random-secret

# Canonical deployed URL used in sign-in links
APP_URL=https://your-dashboard.example.com

# Resend credentials for sign-in emails (required for anyone to sign in)
RESEND_API_KEY=re_your_sending_only_key
EMAIL_FROM=Folly <hello@your-verified-domain.example>

# Secret that lets Vercel Cron run the daily listings refresh (any long random string)
CRON_SECRET=generate-a-long-random-secret
